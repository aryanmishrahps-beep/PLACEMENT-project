rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rules
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Assessment Sessions rules
    match /assessmentSessions/{sessionId} {
      // Candidates can read their own session documents
      allow read: if request.auth != null && (
        resource.data.candidateId == request.auth.uid || 
        request.auth.token.role == 'faculty' || 
        request.auth.token.role == 'admin'
      );
      
      // Candidates can create a new session for themselves with active status & 0 violations
      allow create: if request.auth != null && 
        request.resource.data.candidateId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.violationCount == 0;
      
      // Candidates can update answers while session is active, BUT CANNOT update sensitive fields directly
      allow update: if request.auth != null && 
        resource.data.candidateId == request.auth.uid &&
        resource.data.status == 'active' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'violationCount', 'cancelledAt', 'cancellationReason', 'maxViolations']);

      // Violations subcollection (read-only for candidate; privileged writes via trusted server)
      match /violations/{violationId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.role in ['admin', 'faculty'];
      }
    }

    // Default match for other collections (courses, quizzes, analytics, etc.)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
